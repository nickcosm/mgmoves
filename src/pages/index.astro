---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectLayout from '../layouts/ProjectLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<ProjectLayout title="Nick Cosmo">
				<ul role="list" class="project-list list-none">
					{projects.map((project) => (
						<li class="mb-6">
							<a href={`/projects/${project.id}`} class="block">
								{project.data.cover && (
									<Image
										src={project.data.cover}
										alt={project.data.coverAlt ?? ''}
										widths={[480, 960, 1440]}
										sizes="(min-width: 768px) 50vw, 100vw"
										class="mb-2 h-auto w-full"
									/>
								)}
								<div class="grid grid-cols-12 gap-x-4 my-4 pb-8">
									<div class="col-span-4 md:col-span-4">{project.data.client}</div>
									<div class="col-span-6 md:col-span-6">{project.data.title}</div>
									<div class="col-span-2 md:col-span-2">{project.data.year}</div>
								</div>
							</a>
						</li>
					))}
				</ul>
</ProjectLayout>
