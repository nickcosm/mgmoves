---
import Navigation from './Navigation.astro';
---
<a href="#main-content" class="skip-link">Skip to main content</a> 
<header class="grid grid-cols-12 gap-x-4 m-4 pb-4">
    <div class="col-span-4 md:col-span-4">
        <a href="/">Cosmo</a>
    </div>
    <nav>
      <div class="col-span-6 md:col-span-6">
        <p><a href="mailto:nickcosmo@protonmail.com">Email</a>,&nbsp;<a href="tel:+447751435710">Call</a>.</p> 
      </div>
      <div class="col-span-2 md:col-span-2">
        <p class="contact"><a target="_blank" href="/Nick_Halstead_CV.pdf">CV</a></p>
      </div>
    </nav>
</header>
<script>
document.addEventListener('click', (e) => {
  const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('.skip-link') : null;
  if (!link) return;
  e.preventDefault();
  const href = link.getAttribute('href');
  if (href) {
    const target = document.querySelector(href);
    if (target) {
      if (target instanceof HTMLElement) {
        target.setAttribute('tabindex', '-1');
        target.focus();
      }
    }
  }
});
</script>