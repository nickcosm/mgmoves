---
import Navigation from './Navigation.astro';
import { Image } from 'astro:assets';
import logo from '../assets/img/mg-moves-logo-2_result.webp';
---
<a href="#main-content" class="skip-link">Skip to main content</a> 
<header>
  <nav class="grid grid-cols-12 gap-x-4 pb-4">
    <div class="col-span-12 md:col-span-12">
        <a href="/">
                  <Image
                    src={logo}
										alt="MG Moves Logo"
										sizes="(min-width: 300px) 50vw, 100vw"
										class="mb-2 h-auto w-fit"
									/></a>
    </div>
    <div class="col-span-6 md:col-span-6">
      <p><a href="mailto:mgmoves@btinternet.com">Email</a>,&nbsp;<a href="tel:07904802702">Call</a>.</p> 
    </div>
    <div class="col-span-6 md:col-span-6">
      <p class="contact"><a target="_blank" href="https://www.facebook.com/mgmoveslargs/">Facebook</a></p>
    </div>
  </nav>
</header>
<script>
document.addEventListener('click', (e) => {
  const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('.skip-link') : null;
  if (!link) return;
  e.preventDefault();
  const href = link.getAttribute('href');
  if (href) {
    const target = document.querySelector(href);
    if (target) {
      if (target instanceof HTMLElement) {
        target.setAttribute('tabindex', '-1');
        target.focus();
      }
    }
  }
});
</script>