---
import Navigation from './Navigation.astro';
import { Image } from 'astro:assets';
import logo from '../assets/img/mg-moves-logo.webp';
---
<a href="#main-content" class="skip-link">Skip to main content</a> 
<header>
  <nav class="grid grid-cols-12 gap-x-4 pb-4" aria-label="Contact navigation">
    <div class="col-span-6 md:col-span-6">
        <a class="logo" href="/">MG<span class="red">MOVES . . .</span></a>
    </div>
    <div class="col-span-6 md:col-span-6">
      <p><a href="mailto:mgmoves@btinternet.com">Email</a>,
        &nbsp;<a href="tel:07904802702">Call</a>,
        &nbsp;<a target="_blank" href="https://www.facebook.com/mgmoveslargs/">Facebook</a></p> 
    </div>
  </nav>
</header>
<script>
document.addEventListener('click', (e) => {
  const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('.skip-link') : null;
  if (!link) return;
  e.preventDefault();
  const href = link.getAttribute('href');
  if (href) {
    const target = document.querySelector(href);
    if (target) {
      if (target instanceof HTMLElement) {
        target.setAttribute('tabindex', '-1');
        target.focus();
      }
    }
  }
});
</script>