---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import homeImage from '../assets/images/Image00003.webp';

interface Props {
	title: string;
	home?: boolean;
}

const { title, home = false } = Astro.props;

const backgrounds = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/img/Image*.webp', { eager: true }),
).map((mod) => mod.default);
const background = home
	? homeImage
	: backgrounds[Math.floor(Math.random() * backgrounds.length)];
---

<html lang="en">
	<head>
		<Head />
		<title>{title}</title>
	</head>
	<body class="dark relative min-h-dvh">
		<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
			<Image
				src={background}
				alt=""
				widths={[640, 1024, 1600, 2400]}
				sizes="100vw"
				class="media object-cover"
			/>
		</div>
		<main id="main-content" tabindex="-1">
			<div class="sidebar fixed top-3 left-3 z-10 md:w-1/3 p-4 bg-[#000000] scheme-dark right-3 rounded-lg border-2 border-black">
				<Header />
				<Navigation />
				<slot />
			</div>
		</main>
	</body>
</html>
